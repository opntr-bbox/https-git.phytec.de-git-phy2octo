<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<phytec pdn="master" release_uid="BSP-Yocto-Ampliphy-i.MX6UL-master" soc="iMX6UL" supported_builds="
		phyboard-segin-imx6ul-6/phytec-headless-image/ampliphy-5.4.y,
		phyboard-segin-imx6ul-6/phytec-headless-image/ampliphy-vanilla-master,
		phyboard-segin-imx6ul-8/phytec-headless-image/ampliphy-5.4.y,
		phyboard-segin-imx6ul-8/phytec-headless-image/ampliphy-vanilla-master"
		release_type="nightly" build_container="phybuilder/yocto-ubuntu-20.04:phy2"/>

	<remote name="git.phytec" fetch="git://git.phytec.de"/>
	<remote name="ssh.phytec" fetch="ssh://git@git.phytec.de"/>
	<remote name="yocto" fetch="https://git.yoctoproject.org"/>
	<remote name="github.oe" fetch="https://github.com/openembedded" />
	<remote name="ti" fetch="git://git.ti.com"/>
	<remote name="github" fetch="https://github.com"/>

	<default revision="master" remote="git.phytec" sync-j="8"/>

	<project name="poky" path="sources/poky" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project name="meta-openembedded" path="sources/meta-openembedded" remote="github.oe">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project name="meta-qt5/meta-qt5" path="sources/meta-qt5" remote="github"/>
	<project name="rauc/meta-rauc" path="sources/meta-rauc" remote="github"/>
	<project name="meta-security" path="sources/meta-security" remote="yocto">
		<sublayer path="meta-tpm"/>
	</project>
	<project name="meta-arm" path="sources/meta-arm" remote="yocto">
		<ignorebaselayer />
		<sublayer path="meta-arm"/>
		<sublayer path="meta-arm-toolchain"/>
	</project>
	<project name="meta-virtualization" path="sources/meta-virtualization" remote="yocto"/>
	<project name="meta-qt5-phytec" path="sources/meta-qt5-phytec"/>
	<project name="meta-ampliphy" path="sources/meta-ampliphy"/>
	<project name="meta-phytec" path="sources/meta-phytec">
		<copyfile dest="tools/init" src="scripts/init"/>
	</project>
	<project name="meta-fresh" path="sources/meta-fresh"/>
</manifest>
