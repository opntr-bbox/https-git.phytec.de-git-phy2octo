<?xml version='1.0' encoding='UTF-8'?>
<manifest>
	<phytec pdn="dunfell" release_uid="BSP-Yocto-AM62x-dunfell" soc="AM62x"
		supported_builds="
			phyboard-lyra-am62xx-1/phytec-qt5demo-image/yogurt
	" release_type="nightly" build_container="yocto:ubuntu20.04"/>

	<remote fetch="git://git.yoctoproject.org" name="yocto"/>
	<remote fetch="git://git.openembedded.org" name="oe"/>
	<remote fetch="ssh://git@git.phytec.de" name="ssh.phytec"/>
	<remote fetch="https://github.com" name="github"/>
	<remote fetch="git://git.ti.com" name="ti"/>

	<default revision="dunfell" remote="git.phytec" sync-j="8"/>

	<project name="meta-phytec" path="sources/meta-phytec">
		<copyfile dest="tools/init" src="scripts/init" />
	</project>
	<project name="meta-yogurt" path="sources/meta-yogurt"/>
	<project name="poky" remote="yocto" path="sources/poky">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project remote="oe" name="meta-openembedded" path="sources/meta-openembedded">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-gnome"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project remote="github" name="rauc/meta-rauc" path="sources/meta-rauc"/>
	<project remote="yocto" name="meta-arm" path="sources/meta-arm">
		<ignorebaselayer/>
		<sublayer path="meta-arm"/>
		<sublayer path="meta-arm-toolchain"/>
	</project>
	<project remote="github" name="meta-qt5/meta-qt5" path="sources/meta-qt5"/>
	<project remote="yocto" name="meta-ti" path="sources/meta-ti"/>
	<project remote="yocto" name="meta-virtualization" path="sources/meta-virtualization"/>
	<project remote="yocto" name="meta-security" path="sources/meta-security">
		<ignorebaselayer/>
		<sublayer path="meta-tpm"/>
	</project>
</manifest>
