<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<phytec pdn="master" release_uid="BSP-Yocto-Ampliphy-i.MX8MP-master" soc="iMX8MP" supported_builds="
		phyboard-pollux-imx8mp-3/phytec-headless-image/ampliphy,
		phyboard-pollux-imx8mp-3/phytec-qt6demo-image/ampliphy,
		imx8mp-libra-fpsc-1/phytec-headless-image/ampliphy,
		imx8mp-libra-fpsc-1/phytec-qt6demo-image/ampliphy"
		release_type="nightly" bspextension="Ampliphy" build_container="phybuilder/yocto-ubuntu-24.04"/>

	<remote name="git.phytec" fetch="git://git.phytec.de"/>
	<remote name="ssh.phytec" fetch="ssh://git@git.phytec.de"/>
	<remote name="yocto" fetch="git://git.yoctoproject.org"/>
	<remote name="github.yocto" fetch="https://github.com/yoctoproject"/>
	<remote name="oe" fetch="git://git.openembedded.org"/>
	<remote name="qt" fetch="https://code.qt.io/yocto" />
	<remote name="github.oe" fetch="https://github.com/openembedded"/>
	<remote name="github.rauc" fetch="https://github.com/rauc"/>
	<remote name="fsl-community" fetch="https://github.com/Freescale"/>

	<default revision="master" remote="git.phytec" sync-j="8"/>

	<project name="poky" path="sources/poky" remote="github.yocto">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project name="meta-openembedded" path="sources/meta-openembedded" remote="github.oe">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project name="meta-freescale" path="sources/meta-freescale" remote="fsl-community"/>
	<project name="meta-arm" path="sources/meta-arm" remote="yocto">
		<ignorebaselayer />
		<sublayer path="meta-arm"/>
		<sublayer path="meta-arm-toolchain"/>
	</project>
	<project name="meta-rauc" path="sources/meta-rauc" remote="github.rauc"/>
	<project name="meta-virtualization" path="sources/meta-virtualization" remote="yocto"/>
	<project name="meta-qt6" path="sources/meta-qt6" remote="qt" revision="dev" />
	<project name="meta-ampliphy" path="sources/meta-ampliphy"/>
	<project name="meta-phytec" path="sources/meta-phytec">
		<copyfile dest="tools/init" src="scripts/init"/>
	</project>
	<project name="meta-qt6-phytec" path="sources/meta-qt6-phytec"/>
</manifest>
