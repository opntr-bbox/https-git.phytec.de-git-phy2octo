def probe_selected_soc(arg_soc = None):
    global selected_soc
    # first see if arg_soc is a valid input
    if arg_soc:
        if os.path.exists('.repo/manifests.git/refs/remotes/origin/'+ arg_soc):
            print 'Selecting SoC to command line argument: '+arg_soc
            selected_soc = arg_soc
            return True
        else:
            print 'Command line argument '+arg_soc+' is no valid SoC'
            return False
    # find out if there has been a selection before
    try:
        f = open('.repo/manifests.git/refs/heads/default', 'r')
        hashtag = f.read()
        for candidate in os.listdir('.repo/manifests.git/refs/remotes/origin'):
            cf = open('.repo/manifests.git/refs/remotes/origin/'+ candidate)
            if hashtag == cf.read():
                selected_soc = candidate
                print 'Soc Platform: '+selected_soc+' is currently selected'
                return True
    except Exception as e:
       print 'Error while probing for SoC'
       print type(e),e.args,e
    print 'No SoC Platform selected'
    return False

def probe_selected_release():
    global selected_release
    try:
        f = os.readlink('.repo/manifest.xml')
        release = f.split('/',1)[1]
        if release[0:2] == 'PD' and release.endswith('.xml'):
            selected_release = release
            print 'Release: ' + remove_file_extension(release) + ' is currently selected'
            return True
        else:
            print release + ' is no propper release'
    except Exception as e:
        print 'Error while probing for selected Release'
        print type(e),e.args,e
    print 'No Release selected'
    return False
                                 
