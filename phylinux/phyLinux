class _Options:
  help = False


def _ParseArguments(args):
  cmd = None
  opt = _Options()
  arg = []

  for i in range(len(args)):
    a = args[i]
    if a == '-h' or a == '--help':
      opt.help = True

    elif not a.startswith('-'):
      cmd = a
      arg = args[i + 1:]
      break
  return cmd, opt, arg


def _Usage():
  _print(
"""usage: phyLinux COMMAND [ARGS]

The most commonly used phyLinux commands are:

  env       generate a sourceable environment in the current directory
            or run a command in the environment
  help      Display detailed help on a command

For the full documentation have a look into the doc/phylinux directory.
""", file=sys.stderr)
  sys.exit(1)


def _Help(args):
  if args:
    if args[0] == 'init':
      init_optparse.print_help()
      sys.exit(0)
    else:
      _print("error: '%s' is not a bootstrap command.\n"
             % args[0], file=sys.stderr)
  else:
    _Usage()
  sys.exit(1)

def _RunSelf(wrapper_path):
  my_dir = os.path.dirname(wrapper_path)
  my_main = os.path.join(my_dir, 'main.py')
  my_git = os.path.join(my_dir, '.git')

  if os.path.isfile(my_main) and os.path.isdir(my_git):
    for name in ['git_config.py',
                 'project.py',
                 'subcmds']:
      if not os.path.exists(os.path.join(my_dir, name)):
        return None, None
    return my_main, my_git
  return None, None

def _NotInstalled():
  _print('error: phyLinux is not correctly installed.  Use repo tool workflow to init repository.',
         file=sys.stderr)
  sys.exit(1)

def _FindphyLinux():
  """Look for the phyLinux repository installation, starting at the current directory.
  """
  curdir = os.getcwd()
  phylinux = None

  olddir = None
  while curdir != '/' \
    and curdir != olddir \
    and not phylinux:
    phylinux = os.path.join(curdir, phylinuxdir, PHYLINUX_MAIN)
    if not os.path.isfile(phylinux):
      phylinux = None
      olddir = curdir
      curdir = os.path.dirname(curdir)
  return (phylinux, os.path.join(curdir, phylinuxdir))

def main(orig_args):
  phylinux_main, rel_phylinux_dir = _FindphyLinux()
  cmd, opt, args = _ParseArguments(orig_args)

  wrapper_path = os.path.abspath(__file__)
  my_main, my_git = _RunSelf(wrapper_path)

  if not phylinux_main:
    if opt.help:
      _Usage()
    if cmd == 'help':
      _Help(args)
    else:
      _NotInstalled()

  if my_main:
    phylinux_main = my_main

  ver_str = '.'.join(map(str, VERSION))
  me = [sys.executable, phylinux_main,
        '--repo-dir=%s' % rel_phylinux_dir,
        '--wrapper-version=%s' % ver_str,
        '--wrapper-path=%s' % wrapper_path,
        '--']
  me.extend(orig_args)
  me.extend(extra_args)
  try:
    os.execv(sys.executable, me)
  except OSError as e:
    _print("fatal: unable to start %s" % phylinux_main, file=sys.stderr)
    _print("fatal: %s" % e, file=sys.stderr)
    sys.exit(148)


if __name__ == '__main__':
  main(sys.argv[1:])
