import argparse

if __name__ == "__main__":
    # parse command line options
    parser = argparse.ArgumentParser(description='This Programs sets up an environment to work with The Yocto Project'
                                                 'on Phytecs Development Kits')
    parser.add_argument('data-directory', help='input files must exist in this directory.')
    args = parser.parse_args()

    if args.data_directory == "":
        print "No directory givin. Using local dir"
        dir = "./"
    else:
        dir = args.data_directory

    print "dir is: " + dir
