		phyboard-lynx-am62pxx-1/phytec-headless-bundle/ampliphy-vendor-rauc,
		phyboard-lynx-am62pxx-1/phytec-headless-image/ampliphy-vendor-rt,
		phyboard-lynx-am62pxx-1/phytec-qt6demo-image/ampliphy-vendor,
		phyboard-lynx-am62pxx-1/-c populate_sdk phytec-qt6demo-image/ampliphy-vendor"
