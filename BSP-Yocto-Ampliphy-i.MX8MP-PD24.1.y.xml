<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<phytec pdn="PD24.1.y" release_uid="BSP-Yocto-Ampliphy-i.MX8MP-PD24.1.y" soc="iMX8MP" supported_builds="
