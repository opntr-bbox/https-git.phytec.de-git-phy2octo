<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<phytec pdn="PD25.1.y" release_uid="BSP-Yocto-Ampliphy-STM32MP15x-PD25.1.y" soc="STM32MP15x" supported_builds="
		phycore-stm32mp1-3/phytec-headless-image/ampliphy,
		phycore-stm32mp1-3/phytec-qt6demo-image/ampliphy"
		release_type="nightly" bspextension="Ampliphy" build_container="phybuilder/yocto-ubuntu-20.04"/>

	<remote name="git.phytec" fetch="git://git.phytec.de"/>
	<remote name="ssh.phytec" fetch="ssh://git@git.phytec.de"/>
	<remote name="yocto" fetch="https://git.yoctoproject.org"/>
	<remote name="github.oe" fetch="https://github.com/openembedded" />
	<remote name="github.rauc" fetch="https://github.com/rauc/"/>
	<remote name="QT6" fetch="https://code.qt.io/yocto" />

	<default revision="scarthgap" remote="git.phytec" sync-j="8"/>

	<project name="poky" path="sources/poky" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project name="meta-openembedded" path="sources/meta-openembedded" remote="github.oe">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project name="meta-rauc" path="sources/meta-rauc" remote="github.rauc"/>
	<project name="meta-qt6" path="sources/meta-qt6" remote="QT6" revision="6.6" />
	<project name="meta-arm" path="sources/meta-arm" remote="yocto">
		<ignorebaselayer />
		<sublayer path="meta-arm"/>
		<sublayer path="meta-arm-toolchain"/>
	</project>
	<project name="meta-ampliphy" path="sources/meta-ampliphy" revision="scarthgap"/>
	<project name="meta-qt6-phytec" path="sources/meta-qt6-phytec" revision="scarthgap"/>
	<project name="meta-phytec" path="sources/meta-phytec" revision="scarthgap">
		<copyfile dest="tools/init" src="scripts/init"/>
	</project>
</manifest>
