<?xml version='1.0' encoding='UTF-8'?>
<manifest>
	<phytec pdn="PD25.2.y" release_uid="BSP-Yocto-Ampliphy-AM64x-PD25.2.y" soc="AM64x" supported_builds="
		phyboard-electra-am64xx-2/phytec-container-image/ampliphy,
		phyboard-electra-am64xx-2/phytec-headless-image/ampliphy-rt,
		phyboard-electra-am64xx-2/phytec-headless-image phytec-headless-bundle/ampliphy-rauc,
		phyboard-electra-am64xx-2/phytec-headless-image/ampliphy-linux-mainline,
		phyboard-electra-am64xx-2/-c populate_sdk phytec-container-image/ampliphy,
		phyboard-electra-am64xx-3/phytec-headless-image/ampliphy,
		phyboard-electra-am64xx-3/phytec-securiphy-image phytec-securiphy-bundle/securiphy"
		release_type="nightly" bspextension="Ampliphy" build_container="phybuilder/yocto-ubuntu-22.04"/>

	<remote name="yocto" fetch="https://git.yoctoproject.org"/>
	<remote name="oe" fetch="git://git.openembedded.org"/>
	<remote name="git.phytec" fetch="git://git.phytec.de"/>
	<remote name="ssh.phytec" fetch="ssh://git@git.phytec.de"/>
	<remote name="github.oe" fetch="https://github.com/openembedded"/>
	<remote name="github.rauc" fetch="https://github.com/rauc"/>
	<remote name="github.yocto" fetch="https://github.com/yoctoproject"/>
	<remote name="github.betafive" fetch="https://github.com/betafive"/>

	<default revision="scarthgap" remote="git.phytec" sync-j="8"/>

	<project name="meta-phytec" path="sources/meta-phytec" revision="scarthgap">
		<copyfile dest="tools/init" src="scripts/init"/>
	</project>
	<project name="meta-ampliphy" path="sources/meta-ampliphy" revision="scarthgap"/>
	<project name="poky" remote="github.yocto" path="sources/poky">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project name="meta-openembedded" path="sources/meta-openembedded" remote="github.oe">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-gnome"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project name="meta-rauc" path="sources/meta-rauc" remote="github.rauc"/>
	<project name="meta-arm" path="sources/meta-arm" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta-arm"/>
		<sublayer path="meta-arm-toolchain"/>
	</project>
	<project name="meta-ti" path="sources/meta-ti" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta-ti-bsp"/>
		<sublayer path="meta-ti-extras"/>
	</project>
	<project name="meta-virtualization" path="sources/meta-virtualization" remote="yocto"/>
	<project name="meta-linux-mainline" path="sources/meta-linux-mainline" remote="github.betafive"/>
	<project name="meta-security" path="sources/meta-security" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta-tpm"/>
	</project>
</manifest>
