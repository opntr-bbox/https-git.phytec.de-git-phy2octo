<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<phytec pdn="master" release_uid="BSP-Yocto-Ampliphy-i.MX6-master" soc="iMX6" supported_builds="
		phyboard-mira-imx6-3/phytec-headless-image/ampliphy-5.15.y-barebox-master,
		phyboard-mira-imx6-3/phytec-headless-image/ampliphy-vanilla-master,
		phyboard-mira-imx6-5/phytec-headless-image/ampliphy-5.15.y-barebox-master,
		phyboard-mira-imx6-5/phytec-headless-image/ampliphy-vanilla-master,
		phyboard-mira-imx6-14/phytec-headless-image/ampliphy-5.15.y-barebox-master,
		phyboard-mira-imx6-14/phytec-headless-image/ampliphy-vanilla-master"
		release_type="nightly" bspextension="Ampliphy" build_container="phybuilder/yocto-ubuntu-24.04"/>

	<remote name="git.phytec" fetch="git://git.phytec.de"/>
	<remote name="ssh.phytec" fetch="ssh://git@git.phytec.de"/>
	<remote name="yocto" fetch="https://git.yoctoproject.org"/>
	<remote name="github.oe" fetch="https://github.com/openembedded" />
	<remote name="github.qt5" fetch="https://github.com/meta-qt5/"/>
	<remote name="github.rauc" fetch="https://github.com/rauc/"/>

	<default revision="master" remote="git.phytec" sync-j="8"/>

	<project name="poky" path="sources/poky" remote="yocto">
		<ignorebaselayer/>
		<sublayer path="meta"/>
		<sublayer path="meta-poky"/>
	</project>
	<project name="meta-openembedded" path="sources/meta-openembedded" remote="github.oe">
		<ignorebaselayer/>
		<sublayer path="meta-oe"/>
		<sublayer path="meta-networking"/>
		<sublayer path="meta-python"/>
		<sublayer path="meta-multimedia"/>
		<sublayer path="meta-filesystems"/>
		<sublayer path="meta-perl"/>
	</project>
	<project name="meta-qt5" path="sources/meta-qt5" remote="github.qt5"/>
	<project name="meta-rauc" path="sources/meta-rauc" remote="github.rauc"/>
	<project name="meta-security" path="sources/meta-security" remote="yocto">
		<sublayer path="meta-tpm"/>
	</project>
	<project name="meta-virtualization" path="sources/meta-virtualization" remote="yocto"/>
	<project name="meta-qt5-phytec" path="sources/meta-qt5-phytec" revision="master"/>
	<project name="meta-ampliphy" path="sources/meta-ampliphy" revision="master"/>
	<project name="meta-phytec" path="sources/meta-phytec" revision="master">
		<copyfile dest="tools/init" src="scripts/init"/>
	</project>
	<project name="meta-fresh" path="sources/meta-fresh"/>
</manifest>
